<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- System mic mute for apps whose call notification has no mute button (Discord). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Only the apps we bridge. Avoids QUERY_ALL_PACKAGES. -->
    <queries>
        <package android:name="com.discord" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Samukis">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.InspectorActivity"
            android:exported="false"
            android:label="@string/inspector_title"
            android:parentActivityName=".ui.MainActivity" />

        <!-- Event-driven: the system wakes this only when a notification changes. -->
        <service
            android:name=".service.IslandBridgeService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".receiver.DismissReceiver"
            android:exported="false" />

        <receiver
            android:name=".receiver.ActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".receiver.MuteReceiver"
            android:exported="false" />
    </application>
</manifest>
